package RHP;
import java.util.*;
public class UnbelievableArray {
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int m=sc.nextInt();
		int q=sc.nextInt();
		int arr[]=new int[m+1];
		for(int i=0;i<n;i++){
			System.out.println("Case "+(i+1)+":");
			for(int j=1;j<=m;j++){
				arr[j]=sc.nextInt();
			}
		}
		
	    ArrayList<Integer>list=new ArrayList<>();
		for(int i=0;i<q;i++) {
			
			int qt=sc.nextInt();
			if(qt==1){
				int x=sc.nextInt();
				int y=sc.nextInt();
				for(int k=1;k<=n;k++){
					if (arr[k]==x){
						arr[k]=y;
					}
				}
			}else{
				int s=sc.nextInt();
				System.out.println(arr[s]);
			}
		}
			
	}

}
