package RHP;
import java.util.*;
public class RangeMinQueries {
	public static void main(String args[]) {
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int m=sc.nextInt();
		int arr[]=new int[n+1];
		for(int i=1;i<=n;i++) {
			arr[i]=sc.nextInt();
		}
		ArrayList<Integer>list=new ArrayList<>();
		int minN=2000000;
		for(int i=0;i<m;i++) {
			int a=sc.nextInt();
			int b=sc.nextInt();
			for(int j=a;j<=b;i++) {
				minN=Math.min(minN, arr[j]);
			}
			list.add(minN);
		}
		for(int num:list) {
			System.out.println(num);
		}
	}

}
