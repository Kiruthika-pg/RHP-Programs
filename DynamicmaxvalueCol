package RHP;
import java.util.*;
public class DynamicmaxvalueCol {
	public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int[][] matrix = new int[3][3];
        int[][] result = new int[3][3];

        // Input
        for(int i = 0; i < 3; i++) {
            for(int j = 0; j < 3; j++) {
                matrix[i][j] = sc.nextInt();
            }
        }
        for(int i = 0; i < 3; i++) {
            result[i][0] = matrix[i][0];
        }
        for(int j = 1; j < 3; j++) {

            for(int i = 0; i < 3; i++) {

                int max = Integer.MIN_VALUE;
                for(int k = 0; k < 3; k++) {

                    if(k != i) {
                        max = Math.max(max, result[k][j - 1]);
                    }
                }

                result[i][j] = matrix[i][j] + max;
            }
        }

        System.out.println("Result Matrix:");

        for(int i = 0; i < 3; i++) {
            for(int j = 0; j < 3; j++) {
                System.out.print(result[i][j] + "\t");
            }
            System.out.println();
        }

        
        int total = Integer.MIN_VALUE;

        for(int i = 0; i < 3; i++) {
            total = Math.max(total, result[i][2]);
        }

        System.out.println("Maximum = " + total);
    }

}
