package RHP;
import java.util.*;
public class RangeSumQueries {
	public static void main(String args[]) {
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int m=sc.nextInt();
		int arr[]=new int[n+1];
		int prearr[]=new int[n+1];
		for(int i=1;i<=n;i++) {
			arr[i]=sc.nextInt();
			prearr[i]=prearr[i-1]+arr[i];
		}
		
		ArrayList<Integer> res=new ArrayList<>();
		for(int i=0;i<m;i++) {
			int k=sc.nextInt();
			int q=sc.nextInt();
			int sum=prearr[q]-prearr[k-1];
			res.add(sum);
		}
		for(int num:res){
		System.out.println(num);
		}
	}

}
