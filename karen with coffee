import java.util.*;
 
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
 
        int n = sc.nextInt();
        int k = sc.nextInt();
        int q = sc.nextInt();
 
        int MAX = 200000;
 
        int[] diff = new int[MAX + 2];
 
        for (int i = 0; i < n; i++) {
            int l = sc.nextInt();
            int r = sc.nextInt();
 
            diff[l]++;
            diff[r + 1]--;
        }
 
        int[] count = new int[MAX + 1];
        count[1] = diff[1];
 
        for (int i = 2; i <= MAX; i++) {
            count[i] = count[i - 1] + diff[i];
        }
 
        int[] optimal = new int[MAX + 1];
 
        for (int i = 1; i <= MAX; i++) {
            if (count[i] >= k) {
                optimal[i] = 1;
            }
        }
 
        int[] prefix = new int[MAX + 1];
 
        prefix[1] = optimal[1];
 
        for (int i = 2; i <= MAX; i++) {
            prefix[i] = prefix[i - 1] + optimal[i];
        }
 
        while (q-- > 0) {
            int a = sc.nextInt();
            int b = sc.nextInt();
 
            int answer = prefix[b] - prefix[a - 1];
            System.out.println(answer);
        }
 
        sc.close();
    }
}
